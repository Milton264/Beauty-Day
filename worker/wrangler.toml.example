name = "beauty-day-editor"
main = "src/index.js"
compatibility_date = "2026-09-01"

[vars]
SITE_ORIGIN = "https://www.tu-dominio.com"
REPO_OWNER = "TU_USUARIO_GITHUB"
REPO_NAME = "beauty-day"
BRANCH = "main"
CONTENT_PATH = "docs/content/site.json"
UPLOAD_PREFIX = "docs/assets/uploads"

[[ratelimits]]
name = "LOGIN_LIMITER"
namespace_id = "1001"
  [ratelimits.simple]
  limit = 5
  period = 60

[[ratelimits]]
name = "PUBLIC_LIMITER"
namespace_id = "1002"
  [ratelimits.simple]
  limit = 20
  period = 60

# Instalación manual: descomenta estas tres líneas tras crear el namespace.
# [[kv_namespaces]]
# binding = "PRICE_STORE"
# id = "ID_DEVUELTO_POR_CLOUDFLARE"
